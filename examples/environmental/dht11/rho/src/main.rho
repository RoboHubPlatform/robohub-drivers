// dht11 — read the DHT11 temperature and humidity module, in Rho.
//
// The same program as examples/environmental/dht11/c, written in Rho. The names
// below are the foreign functions rho-cimport generates from the board module's
// BSP, reached through the `ffi` module.
//
// @project RoboHub Platform
// @license MIT

module main

import ffi

// The sentinel the board returns when a reading could not be taken.
const VALUE_ERROR: i32 = -1000000

// Print a fixed-point value by hand, so the program needs no float formatting.
// `scale` is 1000 for thousandths of a degree, and 1000 for thousandths of a
// percent, so the fraction is always three digits.
fn print_fixed(value: i32, scale: i32) void {
    let negative: bool = value < 0
    let magnitude: i32 = value
    if negative {
        magnitude = 0 - value
    }
    let whole: i32 = magnitude / scale
    let fraction: i32 = magnitude % scale

    if negative {
        print("-")
    }
    print(string.from_i32(whole))
    print(".")

    if fraction < 100 { print("0") }
    if fraction < 10 { print("0") }
    print(string.from_i32(fraction))
}

fn main() void {
    if robohub_platform_init() != 0 {
        return
    }

    print("\n")
    print("DHT11 temperature and humidity, in Rho\n")
    print("--------------------------------------\n")

    if robohub_dht11_module_open() != 0 {
        print("no DHT11 module: is the platform's dht HAL up?\n")
        return
    }

    while true {
        let t: i32 = robohub_dht11_module_milli_celsius()
        let h: i32 = robohub_dht11_module_milli_percent()

        if t == VALUE_ERROR {
            print("T = read failed\n")
        } else {
            print("T = ")
            print_fixed(t, 1000)
            print(" C\n")
        }

        if h == VALUE_ERROR {
            print("H = read failed\n")
        } else {
            print("H = ")
            print_fixed(h, 1000)
            print(" %\n")
        }

        robohub_dht11_module_sleep_ms(2000)
    }
}
