# ds18b20 temperature example configuration

config RH_HAL_GPIO
    bool "GPIO"
    default y

config RH_HAL_UART
    bool "UART"
    default y

config RH_HAL_TIMER
    bool "Timer"
    default y

config RH_HAL_ONEWIRE
    bool "OneWire"
    default y

config RH_BOARD_PICO_2W
    bool "Pico 2W"
    default y

config RH_BOARD_DS18B20_MODULE
    bool "DS18B20 temperature module"
    default y

config RH_TRANSPORT
    bool "Transport"
    default y

config RH_TELEMETRY
    bool "Telemetry"
    default y

config RH_NET
    bool "Network"
    default y

# The board's identity on the bus. A gateway attributes a reading to this
# number, so two boards on one link must not share it.
# The area this board's readings are numbered in. A gateway owns the area its
# devices are in, and a board with the same node id in another area is another
# device.
config RH_AREA_ID
    int "Area id"
    range 1 65535
    default 1

config RH_NODE_ID
    int "Node id"
    range 1 65535
    default 1

# The network sink. An empty SSID means the node streams over USB only; the
# values here are the defaults, and a deployment writes them in project.conf.
config RH_WIFI_SSID
    string "WiFi SSID"
    default ""

config RH_WIFI_PASSWORD
    string "WiFi password"
    default ""

config RH_TELEMETRY_HOST
    string "Telemetry gateway host"
    default ""

config RH_TELEMETRY_PORT
    int "Telemetry gateway port"
    range 1 65535
    default 5000

# The link this node sends its frames on. The keeper writes these from the
# network connection it configured; a hand build gets USB CDC.
config RH_NODE_TRANSPORT
    string "Node transport"
    default "usb"

config RH_NODE_UART
    string "Node UART link"
    default "uart1"

config RH_NODE_BAUD
    int "Node UART baud"
    range 1200 3000000
    default 115200
